# Copy to .env, next to docker-compose.yml.

# The image pushed from the PC.
IMAGE=myuser/phalbum:arm64

# SeaweedFS version, fixed so a pull never changes the storage engine. Use the
# version that wrote your data; to see the one in the image you have now:
#   docker run --rm chrislusf/seaweedfs:latest version
# e.g. "version 30GB 3.97 …" -> SEAWEEDFS_VERSION=3.97
SEAWEEDFS_VERSION=sha256-0b5687190750efa3495a4b5227d08f76756f9d500ab9f84a2fa6c28f47b7fcaf.sig

# Where the database and storage are. These are the services in this compose file.
POSTGRES_HOST=db
POSTGRES_PORT=5432
S3_ENDPOINT=http://seaweedfs:8333

# Credentials: use the same values in .env on the PC.
POSTGRES_USER=phalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phalbum
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Where the NAS is mounted. Must be the same path on the PC.
PHOTOS_ROOT=/mnt/photos
# User the containers run as; must be able to read the photos.
PHOTOS_UID=1000
PHOTOS_GID=1000

# ONNX Runtime threads, leaving CPU for Postgres.
ONNX_THREADS=2
# Set to true if the api runs out of memory: it stops loading the vision model,
# which only disables searching by an uploaded picture.
CLIP_DISABLE_VISION=false
