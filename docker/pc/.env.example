# Copy to .env, next to docker-compose.yml.

# The image pushed from this PC.
IMAGE=myuser/phalbum:amd64

# Where the database and storage are: the Raspberry Pi's address. Give it a
# static IP or DHCP reservation.
POSTGRES_HOST=192.168.1.50
POSTGRES_PORT=5432
S3_ENDPOINT=http://192.168.1.50:8333

# Credentials: use the same values in .env on the Raspberry Pi.
POSTGRES_USER=phalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phalbum
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Where the NAS is mounted. Must be the same path on the Raspberry Pi.
PHOTOS_ROOT=/mnt/photos
# User the container runs as; must be able to read the photos.
PHOTOS_UID=1000
PHOTOS_GID=1000

# Copy originals to the Pi's storage, so they're served without the NAS.
STORE_ORIGINALS=true
