# Settings for docker-compose.rpi.yml. Copy to rpi.env on the Raspberry Pi.

# Same values as in indexer.env on the PC.
POSTGRES_USER=phalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phalbum
# Same keys as in s3.json.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# On the USB SSD: holds the database and SeaweedFS.
DATA_DIR=/mnt/ssd/phalbum
# Where the NAS is mounted. Must be the same path on the PC.
PHOTOS_ROOT=/mnt/photos
# User the containers run as; must be able to read the photos.
PHOTOS_UID=1000
PHOTOS_GID=1000

# ONNX Runtime threads, leaving CPU for Postgres.
ONNX_THREADS=2
# Set to true if the api runs out of memory: it stops loading the vision model,
# which only disables searching by an uploaded picture.
CLIP_DISABLE_VISION=false
