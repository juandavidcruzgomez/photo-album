# Settings for docker-compose.indexer.yml. Copy to indexer.env on the PC.

# The Raspberry Pi's address; give it a static IP or DHCP reservation.
RPI_HOST=192.168.1.50

# Same values as in rpi.env on the Raspberry Pi.
POSTGRES_USER=phalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phalbum
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Where the NAS is mounted. Must be the same path on the Raspberry Pi.
PHOTOS_ROOT=/mnt/photos
# User the container runs as; must be able to read the photos.
PHOTOS_UID=1000
PHOTOS_GID=1000

# Copy originals to the SSD on the Pi, so they're served without the NAS.
STORE_ORIGINALS=true
